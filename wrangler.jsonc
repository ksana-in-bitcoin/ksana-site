// The Cloudflare Worker that serves ksana.network (D-113): static files only, no Worker script, so every request is
// served from Cloudflare's cache and none is billed. At every push to main, Workers Builds runs its build command,
// `git submodule update --init && npm run check` (set in the dashboard: Workers Builds ignores `build` below, and
// checks no submodule out by itself), which stops the deploy when a check fails (a broken link or anchor, the two
// languages out of step), then `npx wrangler deploy` in this directory, which attaches the two names below to the
// Worker; Cloudflare creates their DNS records and certificates. www.ksana.network moves to ksana.network by a redirect
// rule of the zone, which runs before the Worker.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ksana-site",
  "compatibility_date": "2026-10-01",
  // a deploy from a machine (npx wrangler deploy) builds and checks the site first, as Workers Builds does
  "build": { "command": "npm run check" },
  "assets": {
    "directory": "./dist",
    // docs/x/index.html answers at /docs/x/, and /docs/x moves there
    "html_handling": "auto-trailing-slash",
    // a path with no file gets dist/404.html with status 404
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "ksana.network", "custom_domain": true },
    { "pattern": "www.ksana.network", "custom_domain": true }
  ],
  // no ksana-site.<account>.workers.dev copy of the site; the builds of other branches still get a preview URL
  "workers_dev": false,
  "preview_urls": true,
  "send_metrics": false
}
